APP_ENV=development
APP_VERSION=1.0.0
DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=1440
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPFAKE_MODEL_ID=hamzenium/ViT-Deepfake-Classifier
DEEPFAKE_MODEL_CHECKPOINT=
MODEL_DEVICE=auto
MODEL_LOCAL_ONLY=false
CALIBRATION_ARTIFACT=
AUTHENTIC_THRESHOLD=0.35
MANIPULATED_THRESHOLD=0.65
MAX_IMAGE_MB=15
MAX_VIDEO_MB=80
MAX_VIDEO_SECONDS=60
MAX_VIDEO_FRAMES=24
MAX_CONCURRENT_INFERENCE=1
STORAGE_PROVIDER=local
STORAGE_ROOT=./private_storage
STORE_ORIGINAL_MEDIA=false
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
